                      <chance>1</chance>
                    </li>
                  </extraMeleeDamages>
                </surpriseAttack>
                <armorPenetrationBlunt>1.12</armorPenetrationBlunt>
                <armorPenetrationSharp>2.52</armorPenetrationSharp>
                <power>34</power>
                <cooldownTime>1.7</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>tail mace</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <armorPenetrationBlunt>6.29</armorPenetrationBlunt>
                <armorPenetrationSharp>0.7</armorPenetrationSharp>
                <power>17</power>
                <cooldownTime>1</cooldownTime>
                <linkedBodyPartsGroup>TailAttackTool</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="R_UltraBoa"]</xpath>
          <value>
            <li Class="CombatExtended.PartialArmorExt">
              <stats>
                <li>
                  <ArmorRating_Sharp>0.75</ArmorRating_Sharp>
                  <parts>
                    <li>Tail</li>
                  </parts>
                </li>
                <li>
                  <ArmorRating_Blunt>0.75</ArmorRating_Blunt>
                  <parts>
                    <li>Tail</li>
                  </parts>
                </li>
                <li>
                  <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
                  <parts>
                    <li>SnakeBody</li>
                  </parts>
                </li>
                <li>
                  <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
                  <parts>
                    <li>SnakeBody</li>
                  </parts>
                </li>
              </stats>
            </li>
          </value>
        </li>



      </operations>
    </match>
  </Operation>
</Patch>