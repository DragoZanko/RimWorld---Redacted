              </li>
              <li Class="CombatExtended.ToolCE">
                <label>right claw</label>
                <capacities>
                  <li>Scratch</li>
                </capacities>
                <surpriseAttack>
                  <extraMeleeDamages>
                    <li>
                      <def>Stun</def>
                      <amount>20</amount>
                      <chance>1</chance>
                    </li>
