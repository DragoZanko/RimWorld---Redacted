          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="R_PinkCheetah"]/tools</xpath>
          <value>
            <tools Inherit="False">
              <li Class="CombatExtended.ToolCE">
                <label>left claw</label>
                <capacities>
                  <li>Scratch</li>
                </capacities>
                <surpriseAttack>
                  <extraMeleeDamages>
                    <li>
                      <def>Stun</def>
                      <amount>20</amount>
                      <chance>1</chance>
                    </li>
                  </extraMeleeDamages>
                </surpriseAttack>
                <extraMeleeDamages/>
