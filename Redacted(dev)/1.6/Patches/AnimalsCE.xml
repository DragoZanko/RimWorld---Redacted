                  <extraMeleeDamages>
                    <li>
                      <def>Stun</def>
                      <amount>20</amount>
                      <chance>1</chance>
                    </li>
                  </extraMeleeDamages>
                </surpriseAttack>
                <extraMeleeDamages/>
                <armorPenetrationBlunt>2.45</armorPenetrationBlunt>
                <armorPenetrationSharp>0.13</armorPenetrationSharp>
                <power>13</power>
                <cooldownTime>1.37</cooldownTime>
                <chanceFactor>0.8</chanceFactor>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
              </li>
              <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <surpriseAttack>
                  <extraMeleeDamages/>
                </surpriseAttack>
                <extraMeleeDamages/>
                <armorPenetrationBlunt>0.65</armorPenetrationBlunt>
                <power>4</power>
                <cooldownTime>0.97</cooldownTime>
                <chanceFactor>0.2</chanceFactor>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
              </li>
            </tools>
          </value>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="R_PinkCheetah"]/comps</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="R_PinkCheetah"]</xpath>
            <value>
              <comps/>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="R_PinkCheetah"]/comps/li[@Class="CombatExtended.CompProperties_ArmorDurability"]</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/ThingDef[defName="R_PinkCheetah"]/comps/li[@Class="CombatExtended.CompProperties_ArmorDurability"]</xpath>
          </match>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="R_PinkCheetah"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_ArmorDurability">
              <Durability>235</Durability>
