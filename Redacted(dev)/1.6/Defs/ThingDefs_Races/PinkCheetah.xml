<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BigCatThingBase">
    <defName>R_PinkCheetah</defName>
    <label>pink cheetah</label>
    <description>A large feline whose reconstruction for reintroduction into ecosystems was different, prioritizing how fast it can be to reach groups and individuals of small animals. They took the base of the original cheetah, the main improvement being the twin turbine lung, an upgrade of the experimental turbine lung in humans which; taking advantage of the horizontal layout of the torso, places two spiracles for better airflow when moving, having an intake at the front via the nose and an exhaust through spiracles in the back, the flow takes advantage of the movement itself for an intake less and less influential on the torso, other improvements are in the veins for better circulation, while the hairs are hollow, these last two along with some of the minor adjustments are to prevent deaths from cold.</description>
    <statBases>
      <MoveSpeed>6.0</MoveSpeed>
      <MarketValue>300</MarketValue>
      <ComfyTemperatureMin>-13</ComfyTemperatureMin>
      <ComfyTemperatureMax>45</ComfyTemperatureMax>
      <FilthRate>1.5</FilthRate>
      <ToxicEnvironmentResistance>-0.25</ToxicEnvironmentResistance>
      <Wildness>0.7</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>right claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <maxPreyBodySize>0.8</maxPreyBodySize>
      <baseHealthScale>1.2</baseHealthScale>
      <trainability>Intermediate</trainability>
      <manhunterOnTameFailChance>0.20</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.40</manhunterOnDamageChance>
      <petness>0.1</petness>
      <headPosPerRotation>
        <li>(0.0, 0, 0.27)</li>
        <li>(0.36, 0, 0.1)</li>
        <li>(0.0, 0, 0.03)</li>
        <li>(-0.36, 0, 0.1)</li>
      </headPosPerRotation>
    </race>
  </ThingDef>

  <PawnKindDef ParentName="BigCatKindBase">
    <defName>R_PinkCheetah</defName>
    <label>pink cheetah</label>
    <race>R_PinkCheetah</race>
    <combatPower>110</combatPower>
    <ecoSystemWeight>0.40</ecoSystemWeight>
    <abilities>
      <li>R_Run</li>
    </abilities>
    <lifeStages>
      <li>
        <label>pink cheetah cub</label>
        <bodyGraphicData>
          <texPath>Animal/PinkCheetah/PinkCheetah</texPath>
          <drawSize>1</drawSize>
          <shaderType>Cutout</shaderType>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Cougar/Dessicated_Cougar</texPath>
          <drawSize>1</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Animal/PinkCheetah/PinkCheetah</texPath>
          <drawSize>1.3</drawSize>
          <shaderType>Cutout</shaderType>
          <shadowData>
            <volume>(0.3, 0.3, 0.3)</volume>
            <offset>(0,0,-0.3)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Cougar/Dessicated_Cougar</texPath>
          <drawSize>1.3</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Animal/PinkCheetah/PinkCheetah</texPath>
          <drawSize>2.06</drawSize>
          <shaderType>Cutout</shaderType>
          <shadowData>
            <volume>(0.4, 0.4, 0.4)</volume>
            <offset>(0,0,-0.1)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Cougar/Dessicated_Cougar</texPath>
          <drawSize>2.06</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

  <AbilityDef>
    <defName>R_Run</defName>
    <label>run</label>
    <description>A different movement than usual, optimized for speed.</description>
    <iconPath>Animal/Run</iconPath>
    <cooldownTicksRange>10000</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <hotKey>Misc1</hotKey>
    <targetRequired>false</targetRequired>
    <comps>
      <li Class="DragoZanko.Redacted.Animal.Ability">
        <hediffDef>R_Run_Hediff</hediffDef>
        <onlyApplyToSelf>true</onlyApplyToSelf>
      </li>
    </comps>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>-1</range>
      <warmupTime>0.8</warmupTime>
      <drawAimPie>false</drawAimPie>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
  </AbilityDef>

  <HediffDef>
    <defName>R_Run_Hediff</defName>
    <label>running</label>
    <defaultLabelColor>(50, 77, 250)</defaultLabelColor>
    <description>It's running.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>5000</disappearsAfterTicks> 
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <hungerRateFactorOffset>0.05</hungerRateFactorOffset>
        <statOffsets>
          <ToxicEnvironmentResistance>-0.75</ToxicEnvironmentResistance>
          <ComfyTemperatureMin>-4</ComfyTemperatureMin> 
          <ComfyTemperatureMax>-5</ComfyTemperatureMax>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>0.40</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>