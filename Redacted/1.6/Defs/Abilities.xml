<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <AbilityDef>
    <defName>R_Jump</defName>
    <label>Jump</label>
    <description>An accumulation of energy and effort to move against gravity, rising into the air for a moment.</description>
    <iconPath>Jump</iconPath>
    <cooldownTicksRange>50</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <jobDef>CastJump</jobDef>
    <verbProperties>
      <verbClass>DragoZanko.Redacted.Verb_DynamicJump</verbClass>
      <label>jump</label>
      <violent>false</violent>
      <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
      <warmupTime>0.3</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <modExtensions>
      <li Class="DragoZanko.Redacted.AbilityValueExtension">
        <AbilityValue>300</AbilityValue>
      </li>
    </modExtensions>
  </AbilityDef>

</Defs>